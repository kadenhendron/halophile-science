<div id="lightbox">
	<div id="lightbox__background"></div>
	<div id="lightbox__image-container">
		<div id="lightbox__image-zoom-container">
			<img draggable="false" id="lightbox__image" src="">
		</div>
	</div>
	<div id="lightbox__info">
		<span id="lightbox__caption">
			<span id="lightbox__title"></span>
			<span id="lightbox__date"></span>
			<span id="lightbox__materials"></span>
			<span id="lightbox__counter">1/1</span>
			<div id="lightbox__text"></div>
		</span>

		<span id="lightbox__controls">
			<img id="lightbox__back" src="img/controls__left.svg">
			<img id="lightbox__close" src="img/controls__close.svg">
			<img id="lightbox__next" src="img/controls__right.svg">
		</span>
	</div>
</div>