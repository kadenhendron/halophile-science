{% set pageTitle = "portfolio | halophile.science" %}
{% set pageDescription = "" %}
{% set metaImage = "" %}

{% extends "_layout.twig" %}

{% block content %}

	<section id="portfolio__content">
		{% set portfolioEntries = craft.entries.section('portfolio').all() %}

		{% for entry in portfolioEntries %}
			<div class="portfolio__item">

                {# <div class="portfolio__image"></div> #}
				{% if entry.photos %}
					{% set titleNoHTML = entry.portfolioItemTitle|striptags %}
					<img src="{{ entry.photos.one().getUrl('squareGridThumbnail') }}" alt="{{ titleNoHTML }}">
				{% endif %}

				{% set title = entry.portfolioItemTitle|replace({'<p>': '', '</p>': ''}) %}	{# remove <p> tags from title #}
				<h2 class="portfolio__item__title">{{ title|raw }}</h2>
				<div class="portfolio__item__date">{{ entry.date|date('F Y') }}</div>
                
				<div class="portfolio__item__material">{{ entry.materials }}</div>
			</div>
		{% endfor %}
	</section>


{% endblock %}
