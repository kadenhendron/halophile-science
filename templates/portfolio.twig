{% set pageTitle = "portfolio | halophile.science" %}
{% set pageDescription = "" %}
{% set metaImage = "" %}

{% extends "_layout.twig" %}

{% block content %}

	<section id="portfolio__content">
		{% set portfolioEntries = craft.entries.section('portfolio').all() %}

		{% for entry in portfolioEntries %}
			<div class="portfolio__item">

				<div class="lightbox-trigger">
				{% if entry.photos %}
					<div class="lightbox-photos">
						{% for photo in entry.photos.all() %}
							<div data-src="{{ photo.getUrl('lightboxPhoto') }}" data-width="{{ photo.width }}" data-height="{{ photo.height }}"></div>
						{% endfor %}
					</div>

					{# Thumbnail #}
					{% set titleNoHTML = entry.portfolioItemTitle|striptags %}
					<img src="{{ entry.photos.one().getUrl('squareGridThumbnail') }}" alt="{{ titleNoHTML }}">
				{% endif %}
				</div>

				{# Title and info #}
				{% set title = entry.portfolioItemTitle|replace({'<p>': '', '</p>': ''}) %}

				<div class="portfolio__item__text">
					<h2 class="portfolio__item__title lightbox-title">
						{{ title|raw }}

						{% if entry.available %}
							<a class="portfolio__item__available" href="inquire">available</a>
						{% endif %}
					</h2>
					<div class="portfolio__item__date lightbox-date">{{ entry.date|date('F Y') }}</div>
					<div class="portfolio__item__material lightbox-material">{{ entry.materials }}</div>


				</div>
			</div>
		{% endfor %}
	</section>

	{% include '_lightbox.twig' %}

{% endblock %}
